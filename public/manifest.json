    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Berita Terkini",
      "short_name": "Terkini",
      "description": "Daftar artikel terbaru",
      "url": "/berita?utm_source=pwa-shortcut",
      "icons": [{ "src": "/lensaplus-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Bisnis & Ekonomi",
      "short_name": "Bisnis",
      "description": "Berita bisnis dan ekonomi",
      "url": "/kategori/bisnis-ekonomi?utm_source=pwa-shortcut",
      "icons": [{ "src": "/lensaplus-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Hukum",
      "short_name": "Hukum",
      "description": "Berita hukum",
      "url": "/kategori/hukum?utm_source=pwa-shortcut",
      "icons": [{ "src": "/lensaplus-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Cari Berita",
      "short_name": "Cari",
      "description": "Pencarian artikel",
      "url": "/search?utm_source=pwa-shortcut",
      "icons": [{ "src": "/lensaplus-icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/search",
    "method": "GET",
    "params": {
      "title": "q",
      "text": "q",
      "url": "q"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+lensaplus",
      "url": "/?ref=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
