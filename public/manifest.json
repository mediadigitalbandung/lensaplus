{
  "id": "/",
  "name": "Lensaplus — Portal Berita Digital Modern",
  "short_name": "Lensaplus",
  "description": "Portal berita digital nasional Indonesia — menyajikan informasi terkini seputar politik, hukum, bisnis, ekonomi, olahraga, teknologi, dan peristiwa Nusantara tepercaya.",
  "start_url": "/?utm_source=pwa",
  "scope": "/",
  "display": "standalone",
