# Database (Local PostgreSQL)
DATABASE_URL="postgresql://lensaplus:password@localhost:5432/lensaplus"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"
SINGLE_DEVICE_ENFORCEMENT="true"

# Settings AES-256-GCM encryption key (openssl rand -base64 32)
SETTINGS_ENCRYPTION_KEY=""

# Setup key (for initial database seeding via /api/setup?key=YOUR_KEY)
SETUP_KEY="your-setup-key-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Lensaplus"
NEXT_PUBLIC_APP_ENV=""
HOSTNAME="0.0.0.0"

# Cron Secret (for scheduled publishing — used by systemd/cron on VPS)
CRON_SECRET="your-cron-secret-here"

# Obsidian editorial vault sync token (used by tools/sync-obsidian.mjs)
# Generate: openssl rand -hex 32
OBSIDIAN_SYNC_TOKEN=""

# Sentry error tracking (optional — auto-disabled if empty)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Cloudflare Turnstile & Origin Guard (optional bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
CLOUDFLARE_ORIGIN_SECRET=""

# Web Push VAPID keys (optional — generate via `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:redaksi@lensaplus.com"

# Email (Resend — https://resend.com, free 100/day)
RESEND_API_KEY="re_your-api-key-here"
EMAIL_FROM="Lensaplus <noreply@lensaplus.com>"

# Optional Brevo SMTP / Cloudflare Email Routing
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER=""
BREVO_SMTP_PASS=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_GLOBAL_API_KEY=""
CLOUDFLARE_EMAIL=""
CLOUDFLARE_ACCOUNT_ID=""

# AI / Research / Transcription / TTS / Anti-Spam (optional env fallbacks; can also be set in /panel/pengaturan)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=""
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL=""
GEMINI_API_KEY=""
GOOGLE_AISTUDIO_KEY=""
GEMINI_TTS_MODEL=""
GEMINI_TTS_VOICE=""
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL=""
ELEVENLABS_VOICE_ID=""
TTS_PROVIDER=""
DEEPGRAM_API_KEY=""
AKISMET_API_KEY=""
AKISMET_BLOG_URL=""

# Media & Video Workers (optional binary/cookies overrides)
FFMPEG_PATH=""
YTDLP_PATH=""
YTDLP_COOKIES=""

# Analytics & Search Indexing (optional env fallbacks)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GA4_PROPERTY_ID=""
GSC_SITE_URL=""
GOOGLE_CREDENTIALS_JSON=""
GOOGLE_INDEXING_QUOTA_LIMIT="200"
INDEXNOW_KEY=""
BING_VERIFICATION=""
YANDEX_VERIFICATION=""

# Social Media OAuth / Publishing (optional)
META_APP_ID=""
META_APP_SECRET=""
THREADS_APP_ID=""
NEXT_PUBLIC_THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_REDIRECT_URI="https://lensaplus.com/"
LENSAPLUS_SOCIAL_URLS=""
